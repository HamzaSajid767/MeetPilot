{
  "protocolVersion": "1.0.0",
  "minimumSupportedVersion": "1.0.0",
  "limits": {
    "maxPayloadBytes": 1048576,
    "maxMessageNameLength": 128,
    "maxCorrelationIdLength": 64
  },
  "timeouts": {
    "handshakeMilliseconds": 5000,
    "heartbeatIntervalMilliseconds": 2000,
    "defaultRequestMilliseconds": 10000
  },
  "reservedChannels": {
    "control": "control",
    "events": "events"
  },
  "messageDirections": ["request", "response", "event"],
  "commands": [
    "Ping",
    "Pong",
    "HealthCheck",
    "Shutdown",
    "Initialize",
    "GetVersion",
    "PlayPhrase",
    "StopPlayback",
    "PlayAudio",
    "GetAudioOutputDevices",
    "SetOutputDevice",
    "GetAudioInputDevices",
    "StartMicrophone",
    "StopMicrophone",
    "SetMixerGains",
    "PlayTestTone",
    "GetAvailableVoices",
    "SynthesizeSpeech",
    "StartRecording",
    "StopRecording",
    "CancelRecording",
    "SpeakText",
    "GetAudioDevices",
    "SetMicrophone",
    "SetVirtualOutput",
    "ReloadConfiguration",
    "Handshake",
    "StartEngine",
    "StopEngine",
    "SetDevices",
    "PlayClip",
    "PlayTts",
    "SetStemGains",
    "SetDucking",
    "GetHealth"
  ],
  "events": [
    "HostStarted",
    "HostStopped",
    "PlaybackStarted",
    "PlaybackFinished",
    "PlaybackCompleted",
    "PlaybackFailed",
    "DeviceChanged",
    "HealthStatusChanged",
    "ErrorOccurred",
    "EngineStateChanged",
    "DeviceListChanged",
    "DeviceLost",
    "PlaybackProgress",
    "PlaybackEnded",
    "PlaybackError",
    "MicrophoneStarted",
    "MicrophoneStopped",
    "MicrophoneFailed",
    "AudioLevels",
    "Underrun",
    "Overrun",
    "HealthSnapshot"
  ],
  "errorCodes": [
    "UnknownError",
    "InvalidMessage",
    "UnsupportedVersion",
    "Timeout",
    "DeviceUnavailable",
    "PlaybackFailed",
    "ConfigurationError",
    "InternalError"
  ]
}
