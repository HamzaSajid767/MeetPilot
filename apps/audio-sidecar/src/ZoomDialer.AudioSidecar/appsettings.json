{
  "Application": {
    "Name": "Zoom Dialer Audio Sidecar"
  },
  "SidecarLogging": {
    "FileNamePrefix": "sidecar",
    "IncludeScopes": true
  },
  "Audio": {
    "TargetSampleRateHz": 48000,
    "BufferMilliseconds": 20
  },
  "Pipe": {
    "MaxPayloadBytes": 1048576
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
